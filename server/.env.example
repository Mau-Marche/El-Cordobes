# ============================================================
#  El Cordobés — Variables de entorno del servidor
#
#  Copiá este archivo a .env y completá con tus datos reales:
#    copy .env.example .env
# ============================================================

# Cadena de conexión a PostgreSQL
# Formato: postgresql://USUARIO:CONTRASEÑA@HOST:PUERTO/NOMBRE_DB
DATABASE_URL="postgresql://postgres:TU_PASSWORD@localhost:5432/el_cordobes"

# Clave secreta para firmar los JWT (inventate una larga y aleatoria)
JWT_SECRET="inventate-una-clave-secreta-larga-y-segura-aqui"

# Duración de la sesión (h = horas, d = días)
JWT_EXPIRES_IN="8h"

# Puerto del servidor backend
PORT=3000

# Entorno de ejecución: development | production
NODE_ENV="development"
